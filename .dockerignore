# File quyết định thứ KHÔNG được copy vào image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# ── Secret & credential ───────────────────────────────────────────
.env
.env.*
*.pem
*.key

# ── Môi trường ảo & cache Python ─────────────────────────────────
.venv
venv
__pycache__
*.pyc
*.pyo
.pytest_cache

# ── Git & tooling ────────────────────────────────────────────────
.git
.gitignore
.github
.dockerignore
Dockerfile
docker-compose.yml

# ── Tài liệu / ảnh / test — image runtime không cần ──────────────
*.md
screenshots
tests
nginx
railway.toml
render.yaml
LICENSE
.vscode
.idea
